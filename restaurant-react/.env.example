# Environment variables template
# Copy this file to .env.local (git-ignored) and fill in the values of your Supabase project
# (Supabase dashboard > Project Settings > API). Both values are built into the app at build time.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The project's publishable (anon) key. Never put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-publishable-key
